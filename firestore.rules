rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User root document and all nested collections (topics, tasks, notes, habits, etc.)
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      match /{allPaths=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
