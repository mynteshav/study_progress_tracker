{
  "name": "study-tracker",
  "version": "1.1.0",
  "description": "Native Study Tracker Desktop Application",
  "main": "main.js",
  "type": "commonjs",
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "start": "electron .",
    "build": "tsc && vite build",
    "package": "npm run build && electron-builder"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor/core": "^8.5.0",
    "@emailjs/browser": "^4.4.1",
    "bcryptjs": "^2.4.3",
    "chart.js": "^4.4.1",
    "jeep-sqlite": "^2.8.0",
    "lucide-react": "^1.29.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.11.24",
    "@types/react": "^18.2.61",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react": "^4.2.1",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "typescript": "^5.3.3",
    "vite": "^5.1.4",
    "vite-plugin-pwa": "^1.3.0"
  },
  "build": {
    "appId": "com.studytracker.app",
    "productName": "Study Tracker",
    "npmRebuild": false,
    "asarUnpack": [
      "**/node_modules/sqlite3/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Study Tracker",
      "uninstallDisplayName": "Study Tracker"
    },
    "files": [
      "dist/**/*",
      "main.js",
      "preload.js",
      "node_modules/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist_electron"
    },
    "asar": true
  }
}
